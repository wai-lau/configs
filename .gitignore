# Ignore everything
*
!.gitignore
!.gitignoreglobal
!.gitconfig
!CLAUDE.md
!.vimrc
!.zshrc
!.tmux.conf
!.tmux-off.conf

!.vim
!.vim/*
!.vim/**/*

!.alias.zsh
!.local.zsh

!.claude
!.claude/statusline-command.sh

!docs/
!docs/*

!src/
!src/repo/
!src/repo/scripts/
!src/repo/scripts/rc/
!src/repo/scripts/rc/rc.sh

# macOS cruft — re-ignore even inside whitelisted dirs (last match wins)
.DS_Store
**/.DS_Store

