# Ignore everything
*
!.gitignore
!.gitignoreglobal
!.gitconfig
!.vimrc
!.zshrc
!.tmux.conf

!.vim
!.vim/*
!.vim/**/*

!.config
!.config/karabiner
!.config/karabiner/**/*

!.config/iterm2
!.config/iterm2/**/*

!.alias.zsh
!.local.zsh

!src/
!src/repo/
!src/repo/scripts/
!src/repo/scripts/rc/
!src/repo/scripts/rc/rc.sh

