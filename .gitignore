# Ignore everything
*
!.gitignore
!.gitignoreglobal
!.gitconfig
!CLAUDE.md
!/README.md
!.vimrc
!.zshrc
!.tmux.conf
!.tmux-off.conf
!.tmux-ssh.conf

# ~/bin scripts (tmux-osc52 clipboard helper, sourced by .tmux-ssh.conf)
!bin/
!bin/*
# host-local ~/bin: project symlinks (own repos), wai-owned copies, vendored
# tools, WSL-only shims -- never shared (droplet home is /root)
bin/aider
bin/emet
bin/emo
bin/homo
bin/sox
bin/voice
bin/git-filter-repo
bin/xdg-open

!.vim
!.vim/*
!.vim/**/*

!.alias.zsh
!.local.zsh

# graphify: config tracked, generated graph-out/ stays local (not committed)
!.graphifyignore

!.claude
!.claude/statusline-command.sh
!.claude/hooks
!.claude/hooks/*
!.claude/commands
!.claude/commands/*
!.claude/commands/**/*

!docs/
!docs/*

!src/
!src/repo/
!src/repo/scripts/
!src/repo/scripts/rc/
!src/repo/scripts/rc/rc.sh

# macOS cruft — re-ignore even inside whitelisted dirs (last match wins)
.DS_Store
**/.DS_Store

