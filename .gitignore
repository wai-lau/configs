# Ignore everything
*
!.gitignore
!.gitignoreglobal
!.gitconfig
!CLAUDE.md
!/README.md
!.vimrc
!.zshrc
!.tmux.conf
!.tmux-off.conf

!.vim
!.vim/*
!.vim/**/*

!.alias.zsh
!.local.zsh

# graphify structural graph (AST-only); cache/ stays ignored
!.graphifyignore
!graphify-out/
!graphify-out/graph.json
!graphify-out/graph.html
!graphify-out/GRAPH_REPORT.md

!.claude
!.claude/statusline-command.sh
!.claude/hooks
!.claude/hooks/*
!.claude/commands
!.claude/commands/*
!.claude/commands/**/*

!docs/
!docs/*

!src/
!src/repo/
!src/repo/scripts/
!src/repo/scripts/rc/
!src/repo/scripts/rc/rc.sh

# macOS cruft — re-ignore even inside whitelisted dirs (last match wins)
.DS_Store
**/.DS_Store

