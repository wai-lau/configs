#!/usr/bin/env python3
"""md FILE.md -- render a markdown file and open it in Windows Chrome (WSL).

Renders GitHub-style (marked.js + github-markdown-css, loaded by Chrome from
CDN), writes a temp .html, and opens it in Chrome via the \\wsl.localhost path.
A <base> tag points at the source dir so relative links/images resolve.
"""
import html
import json
import os
import pathlib
import subprocess
import sys
import tempfile

CHROME = os.environ.get(
    "MD_CHROME",
    "/mnt/c/Program Files/Google/Chrome/Application/chrome.exe",
)

TEMPLATE = """<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>__TITLE__</title>
<base href="__BASE__">
<link rel="stylesheet"
  href="https://cdn.jsdelivr.net/npm/github-markdown-css@5/github-markdown.css">
<script src="https://cdn.jsdelivr.net/npm/marked@12/marked.min.js"></script>
<style>
  body { margin: 0; background: #0d1117; }
  @media (prefers-color-scheme: light) { body { background: #fff; } }
  .markdown-body {
    box-sizing: border-box; max-width: 900px;
    margin: 0 auto; padding: 32px 24px 64px;
  }
</style>
</head>
<body>
<article class="markdown-body" id="out"></article>
<script>
  const SRC = __MD__;
  marked.setOptions({ gfm: true, breaks: false });
  document.getElementById("out").innerHTML = marked.parse(SRC);
</script>
</body>
</html>
"""


def die(msg):
    sys.stderr.write("md: " + msg + "\n")
    sys.exit(1)


def win_path(p):
    return subprocess.check_output(["wslpath", "-w", str(p)]).decode().strip()


def main():
    if len(sys.argv) != 2 or sys.argv[1] in ("-h", "--help"):
        die("usage: md FILE.md")
    src = pathlib.Path(sys.argv[1]).expanduser()
    if not src.is_file():
        die("no such file: " + str(src))
    src = src.resolve()

    text = src.read_text(encoding="utf-8", errors="replace")
    payload = json.dumps(text).replace("</", "<\\/")  # neutralize </script>

    # file:// base from the Windows form of the source dir, so relative
    # links and images render. \\wsl.localhost\.. -> file://wsl.localhost/..
    base = "file:" + win_path(src.parent).replace("\\", "/") + "/"

    page = (
        TEMPLATE
        .replace("__TITLE__", html.escape(src.name))
        .replace("__BASE__", html.escape(base, quote=True))
        .replace("__MD__", payload)
    )

    tmp = tempfile.NamedTemporaryFile(
        "w", prefix="md-", suffix=".html", delete=False, encoding="utf-8"
    )
    tmp.write(page)
    tmp.close()

    if not pathlib.Path(CHROME).is_file():
        die("chrome not found at " + CHROME + " (set MD_CHROME)")

    subprocess.Popen(
        [CHROME, win_path(tmp.name)],
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
    )


if __name__ == "__main__":
    main()
